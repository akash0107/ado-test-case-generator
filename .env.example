# Azure DevOps connection for the manual-test-case-generator skill.
# Copy this file to .env and fill in the values. Never commit .env.

# Organization URL, e.g. https://dev.azure.com/contoso (or https://contoso.visualstudio.com)
ADO_ORG_URL=https://dev.azure.com/your-organization

# Project name exactly as shown in Azure DevOps (spaces allowed, no quotes needed)
ADO_PROJECT=Your Project Name

# Personal Access Token
#   Read-only use:        Work Items (Read)
#   Publishing cases:     Work Items (Read & write)
#   Adding to test suite: Test Management (Read & write)
ADO_PAT=
